# Produção — copie para .env.production e preencha. NUNCA versione o arquivo preenchido.
APP_NAME="SerTec Food"
# Gere com: docker run --rm sertec-food-app php artisan key:generate --show
APP_KEY=
APP_URL=https://admin.cardapios.seudominio.com.br

# Domínios (o DNS precisa apontar para este servidor — docs/OPERATIONS.md)
TENANCY_BASE_DOMAIN=cardapios.seudominio.com.br
TENANCY_ADMIN_HOST=admin.cardapios.seudominio.com.br
# E-mail para avisos do Let's Encrypt
ACME_EMAIL=infra@seudominio.com.br

# Banco (senhas fortes e diferentes)
DB_DATABASE=sertec_food
DB_USERNAME=sertec
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Sessão: cookie só do próprio host (não preencha SESSION_DOMAIN)
SESSION_LIFETIME=720

# Só se houver CDN/balanceador NA FRENTE do Caddy (IPs separados por vírgula)
TRUSTED_PROXIES=

# LGPD: meses até apagar dados pessoais de pedidos antigos
PRIVACY_RETENTION_MONTHS=24

# Backups (ops/backup.sh): retenção em dias e senha para criptografar (opcional, recomendado)
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=

MERCADOPAGO_BASE_URL=https://api.mercadopago.com
