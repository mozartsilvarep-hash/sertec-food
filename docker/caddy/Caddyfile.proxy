# Borda do SerTec Food ATRÁS DE OUTRO SERVIDOR WEB (ex.: Nginx do aaPanel).
#
# Use quando as portas 80/443 do servidor já são de outro programa. Quem
# termina o HTTPS (certificados Let's Encrypt) é o servidor da frente; este
# Caddy só escuta HTTP numa porta local (127.0.0.1:8088 no compose) e entrega
# as SPAs e o PHP. Ativado por CADDY_CONFIG=Caddyfile.proxy (ver
# docs/DEPLOY-AAPANEL.md). Mantenha as rotas iguais às do Caddyfile principal.
#
# PHP: cada php_fastcgi tem "root * …" antes e try_files explícito. Não use
# "index off": nessa versão do Caddy ele desliga o try_files e nenhuma rota
# chega ao PHP (resposta 200 vazia).
#
# Segurança:
# - IP do cliente: vem do X-Forwarded-For SOMENTE quando a conexão chega de
#   rede privada (o proxy local). Em modo estrito, o Caddy lê o cabeçalho da
#   direita para a esquerda e para no primeiro IP não confiável, então um
#   X-Forwarded-For forjado pelo visitante não é aceito. O PHP recebe esse IP
#   em REMOTE_ADDR; o Laravel continua sem confiar em proxy (TRUSTED_PROXIES
#   vazio).
# - O PHP recebe HTTPS=on: o servidor da frente só repassa tráfego HTTPS
#   (o redirecionamento HTTP → HTTPS é configurado lá).
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}
	# Respostas comprimidas (HTML, JS, CSS, JSON): cardápio carrega bem mais rápido no 4G.
	encode zstd gzip
}

# Proteções da borda e páginas de erro (importado em cada site).
(edge) {
	# Envios: fotos até 10 MB (igual ao PHP). Corpo maior nem chega ao app.
	request_body {
		max_size 12MB
	}
	# Robôs procurando arquivos sensíveis (/.env, /.git, wp-login.php,
	# phpmyadmin...): 404 imediato, sem passar pelo PHP nem pelas SPAs.
	# /.well-known continua livre (certificados e afins).
	@probes {
		path /.* */.* *.php *.phtml *.env *.ini *.sql *.bak *.old *.swp /wp-* /wordpress* /xmlrpc* /cgi-bin/* /phpmyadmin* /pma/* /vendor/* /node_modules/* /server-status* /actuator*
		not path /.well-known/*
	}
	handle @probes {
		respond 404
	}
	# Erros da própria borda (ex.: PHP reiniciando durante o deploy = 502):
	# a API responde no formato de sempre; as telas, com uma página amigável.
	# Erros do Laravel (403, 404, 500...) têm páginas próprias em
	# backend/resources/views/errors.
	handle_errors {
		import security_headers
		@api path /api/* /up
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			header Retry-After 30
			respond `{"code":"service_unavailable","message":"Sistema em manutenção. Tente de novo em instantes.","details":null,"request_id":null}` 503
		}
		handle {
			root * /srv/www/erros
			map {err.status_code} {erro_pagina} {
				~^5 /indisponivel.html
				default /404.html
			}
			rewrite * {erro_pagina}
			header Cache-Control "no-store"
			file_server
		}
	}
}

(api) {
	handle /api/v1/internal/* {
		respond 404
	}
	handle /api/* {
		root * /var/www/backend/public
		php_fastcgi app:9000 {
			root /var/www/backend/public
			try_files {path} /index.php
			env REMOTE_ADDR {client_ip}
			env HTTPS on
			env REQUEST_SCHEME https
			env SERVER_PORT 443
		}
	}
	handle /up {
		root * /var/www/backend/public
		php_fastcgi app:9000 {
			root /var/www/backend/public
			try_files /index.php
			env REMOTE_ADDR {client_ip}
			env HTTPS on
			env REQUEST_SCHEME https
			env SERVER_PORT 443
		}
	}
	handle_path /storage/* {
		root * /srv/storage
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}
}

# Painel SerTec
http://{$TENANCY_ADMIN_HOST} {
	import security_headers
	import edge
	import api
	handle {
		root * /srv/www/admin
		try_files {path} /index.html
		file_server
	}
}

# Cardápios: subdomínios de plataforma e domínios próprios verificados
# (o app recusa hosts desconhecidos).
http:// {
	import security_headers
	import edge
	import api

	handle /painel/* {
		root * /srv/www/merchant
		uri strip_prefix /painel
		try_files {path} /index.html
		file_server
	}
	redir /painel /painel/ 308

	@asset {
		path /assets/* /robots.txt /favicon.ico
	}
	handle @asset {
		root * /srv/www/storefront
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /var/www/backend/public
		php_fastcgi app:9000 {
			root /var/www/backend/public
			try_files /index.php
			env REQUEST_URI /__storefront
			env REMOTE_ADDR {client_ip}
			env HTTPS on
			env REQUEST_SCHEME https
			env SERVER_PORT 443
		}
	}
}
