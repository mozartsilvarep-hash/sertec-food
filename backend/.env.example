APP_NAME="SerTec Food"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://admin.cardapios.localhost
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Multi-tenancy
TENANCY_BASE_DOMAIN=cardapios.localhost
TENANCY_ADMIN_HOST=admin.cardapios.localhost
TENANCY_DEFAULT_TIMEZONE=America/Sao_Paulo

# MariaDB (docker-compose: host "mariadb"). Defina a senha no seu .env local;
# nunca commite credenciais reais.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=sertec_food
DB_USERNAME=sertec
DB_PASSWORD=

# Sessão: cookie host-only (SESSION_DOMAIN vazio) — não compartilhar entre tenants.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=sertec_food
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@cardapios.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Mercado Pago: credenciais ficam por restaurante no painel (criptografadas).
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
